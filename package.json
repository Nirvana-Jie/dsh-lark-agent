{
  "name": "dsh-lark-agent",
  "version": "0.1.0",
  "description": "Reach your DeepSeek Harness assistant from Feishu / Lark: a dsh plugin built on the official Lark CLI",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "feishu",
    "lark",
    "larksuite",
    "chatbot"
  ],
  "homepage": "https://github.com/Nirvana-Jie/dsh-larkbot#readme",
  "bugs": {
    "url": "https://github.com/Nirvana-Jie/dsh-larkbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nirvana-Jie/dsh-larkbot.git"
  },
  "author": "Nirvana-Jie",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/plugin-icon.png",
    "assets/feishu-logo.png",
    "assets/deepseek-harness-icon.png",
    "assets/readme/desktop-install-01.jpg",
    "assets/readme/desktop-install-02.jpg",
    "assets/readme/desktop-install-03.jpg",
    "assets/readme/desktop-install-steps.mp4",
    "assets/readme/onboarding-connected.jpg",
    "assets/readme/intro.gif",
    "assets/readme/intro.mp4",
    "assets/readme/rich-chart.png",
    "assets/readme/rich-form.png",
    "dist",
    "cordis.patch.yml",
    "team.config.example.json",
    "README.md",
    "README_zh.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:host": "vitest run --project host",
    "test:client": "vitest run --project client",
    "test:compat": "vitest run --project compat",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run test:coverage",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.5",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1 || 3.18.5",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "qrcode": "1.5.4"
  },
  "packageManager": "pnpm@11.22.0"
}
